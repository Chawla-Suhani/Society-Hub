{
  "name": "society-hub",
  "version": "1.0.0",
  "description": "Society management app: visitors with QR passes, bills, complaints, notices. Next.js + Prisma + TypeScript.",
  "scripts": {
    "gen": "prisma generate",
    "dev": "npm run gen && next dev",
    "build": "npm run gen && next build",
    "start": "next start",
    "typecheck": "npm run gen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "npm run gen && tsx prisma/seed.ts",
    "setup": "npm run gen && prisma migrate dev --name init && tsx prisma/seed.ts",
    "test": "npm run gen && tsx test/smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.8",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/internals": "^7.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3"
  }
}