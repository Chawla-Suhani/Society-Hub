# SQLite file, created by `prisma migrate dev`. Path is relative to the project root.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
ENC_KEY="change-me-to-another-long-random-string"
# Passkeys: these must match the URL you open in the browser (hostname only for RP_ID).
RP_ID="localhost"
ORIGIN="http://localhost:3000"
