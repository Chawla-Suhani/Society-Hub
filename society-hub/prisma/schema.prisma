// Society -> Wings -> Flats -> Residents (users linked to a flat).
// Every tenant-owned table carries societyId so every query can be scoped to one society.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  admin
  resident
  guard
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ResidentType {
  owner
  tenant
  family
}

enum PassSource {
  invite
  walkin
}

enum PassStatus {
  APPROVED
  AWAITING_APPROVAL
  REJECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum BillStatus {
  UNPAID
  PAID
}

model Society {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique // residents sign up with this
  address   String?
  city      String?
  createdAt DateTime @default(now())

  wings      Wing[]
  flats      Flat[]
  users      User[]
  passes     VisitorPass[]
  complaints Complaint[]
  notices    Notice[]
  bills      Bill[]
}

model Wing {
  id            Int      @id @default(autoincrement())
  societyId     Int
  name          String // "A", "B", "Tower 1"
  floors        Int
  flatsPerFloor Int
  createdAt     DateTime @default(now())

  society Society  @relation(fields: [societyId], references: [id])
  flats   Flat[]
  notices Notice[]

  @@unique([societyId, name])
}

model Flat {
  id        Int    @id @default(autoincrement())
  societyId Int
  wingId    Int
  floor     Int
  label     String // "A-101"

  society    Society       @relation(fields: [societyId], references: [id])
  wing       Wing          @relation(fields: [wingId], references: [id])
  users      User[]
  passes     VisitorPass[]
  complaints Complaint[]
  bills      Bill[]

  @@unique([societyId, label])
}

model User {
  id             Int           @id @default(autoincrement())
  societyId      Int
  role           Role
  status         UserStatus    @default(PENDING)
  fullName       String
  email          String?       @unique
  phone          String?       @unique
  passwordHash   String? // admin / resident
  pinHash        String? // guard
  flatId         Int?
  residentType   ResidentType?
  proofNote      String?
  rejectReason   String?
  reviewedBy     Int?
  reviewedAt     DateTime?
  totpSecret     String? // AES-GCM encrypted
  totpEnabled    Boolean       @default(false)
  failedAttempts Int           @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime      @default(now())

  society       Society            @relation(fields: [societyId], references: [id])
  flat          Flat?              @relation(fields: [flatId], references: [id])
  credentials   Credential[]
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  passes        VisitorPass[]      @relation("PassCreator")
  complaints    Complaint[]
  comments      ComplaintComment[]
  notices       Notice[]
  auditLogs     AuditLog[]
}

model Credential {
  id           Int      @id @default(autoincrement())
  userId       Int
  credentialId String   @unique
  publicKey    String // base64url
  counter      Int      @default(0)
  transports   String?
  label        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RecoveryCode {
  id       Int     @id @default(autoincrement())
  userId   Int
  codeHash String
  used     Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id          String    @id
  userId      Int
  refreshHash String
  userAgent   String?
  ip          String?
  revoked     Boolean   @default(false)
  stepupUntil DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Challenge {
  id        String   @id
  challenge String
  userId    Int?
  type      String
  expiresAt DateTime
}

model VisitorPass {
  id           Int        @id @default(autoincrement())
  societyId    Int
  flatId       Int
  createdById  Int
  visitorName  String
  visitorPhone String?
  purpose      String?
  code         String     @unique
  source       PassSource @default(invite)
  status       PassStatus
  expiresAt    DateTime
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  checkedInBy  Int?
  createdAt    DateTime   @default(now())

  society   Society @relation(fields: [societyId], references: [id])
  flat      Flat    @relation(fields: [flatId], references: [id])
  createdBy User    @relation("PassCreator", fields: [createdById], references: [id])
}

model Complaint {
  id          Int             @id @default(autoincrement())
  societyId   Int
  flatId      Int?
  userId      Int
  category    String
  title       String
  description String?
  photoFile   String?
  status      ComplaintStatus @default(OPEN)
  assignedTo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  society  Society            @relation(fields: [societyId], references: [id])
  flat     Flat?              @relation(fields: [flatId], references: [id])
  user     User               @relation(fields: [userId], references: [id])
  comments ComplaintComment[]
}

model ComplaintComment {
  id          Int      @id @default(autoincrement())
  complaintId Int
  userId      Int
  body        String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Notice {
  id          Int      @id @default(autoincrement())
  societyId   Int
  wingId      Int? // null = whole society
  title       String
  body        String
  pinned      Boolean  @default(false)
  createdById Int
  createdAt   DateTime @default(now())

  society   Society @relation(fields: [societyId], references: [id])
  wing      Wing?   @relation(fields: [wingId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
}

model Bill {
  id         Int        @id @default(autoincrement())
  societyId  Int
  flatId     Int
  period     String // YYYY-MM
  amount     Int // rupees
  dueDate    DateTime
  status     BillStatus @default(UNPAID)
  paidAt     DateTime?
  method     String?
  paymentRef String?
  createdAt  DateTime   @default(now())

  society Society @relation(fields: [societyId], references: [id])
  flat    Flat    @relation(fields: [flatId], references: [id])

  @@unique([flatId, period])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  societyId Int?
  actorId   Int?
  action    String
  target    String?
  meta      String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}
